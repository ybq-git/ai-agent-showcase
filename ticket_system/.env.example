# Local development defaults to SQLite when DATABASE_URL is empty.
# Docker: mysql://ticket:ticket@mysql:3306/ticket
DATABASE_URL=

# Leave empty to use LocMemCache and eager Celery (local development).
# Docker: redis://redis:6379/0
REDIS_URL=

CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=

SECRET_KEY=replace-with-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ticket-system@example.com
