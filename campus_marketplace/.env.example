# Local development defaults to SQLite if DATABASE_URL is not set.
# MySQL (docker compose): mysql+pymysql://campus:campus@mysql:3306/campus
DATABASE_URL=sqlite:///./campus_marketplace.db

# Leave empty to use the in-process memory cache (tests / no Redis).
# Redis (docker compose): redis://redis:6379/0
REDIS_URL=

JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=*
